# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public publishable/anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# App origin used for auth redirects and emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Leave unset unless an admin script needs privileged access.
# Never prefix this with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Server-only. Used by migration tooling, never by the app runtime.
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Brevo SMTP for Supabase Auth emails (verification, reset, invite).
# These are used by `npm run configure:brevo` when placed in `.env.local`.
# For the optional local `auth.email.smtp` block, export them in the shell or
# put them in a gitignored `.env` file that the Supabase CLI reads. Never used
# by the Next.js app.
# Get the SMTP login and an SMTP key (not an API key) from Brevo → SMTP & API → SMTP.
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=your-brevo-smtp-login
# BREVO_SMTP_KEY=your-brevo-smtp-key
# BREVO_SENDER_EMAIL=no-reply@your-verified-domain.com
# BREVO_SENDER_NAME=Creator Marketplace

# Supabase Management API credentials for `npm run configure:brevo`.
# Create a personal access token with auth:write / auth_config_write permission.
# The account must be an Admin on the Supabase project.
# SUPABASE_ACCESS_TOKEN=your-supabase-access-token
# SUPABASE_PROJECT_REF=your-project-ref
