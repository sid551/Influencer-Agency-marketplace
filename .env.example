# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public publishable/anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# App origin used for auth redirects and emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Leave unset unless an admin script needs privileged access.
# Never prefix this with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Server-only. Used by migration tooling, never by the app runtime.
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
