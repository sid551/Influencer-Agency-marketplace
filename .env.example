# ---------------------------------------------------------------
# Supabase — public values (safe to expose to the browser)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ---------------------------------------------------------------
# Supabase — secret (server-only). NEVER prefix with NEXT_PUBLIC_.
# The app runtime does not use this value; set it only for privileged
# admin/maintenance scripts. Find it in:
# Supabase Dashboard → Settings → API → secret keys
# ---------------------------------------------------------------
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ---------------------------------------------------------------
# Application URL — used for auth redirect / email confirmation links
# Local dev:  http://localhost:3000
# Production: https://your-domain.vercel.app
# Also add this URL to Supabase Dashboard → Authentication → URL Configuration
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Database connection string (migrations tooling only — never used at
# runtime by the app). Supabase Dashboard → Settings → Database
# ---------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
